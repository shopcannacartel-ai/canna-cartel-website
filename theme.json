{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {"palette": [
      {"slug": "forest", "name": "Forest", "color": "#073E24"},
      {"slug": "leaf", "name": "Leaf", "color": "#2A8E58"},
      {"slug": "gold", "name": "Gold", "color": "#C9A34A"},
      {"slug": "ivory", "name": "Ivory", "color": "#F5F3EB"},
      {"slug": "ink", "name": "Ink", "color": "#14261E"},
      {"slug": "white", "name": "White", "color": "#FFFFFF"}
    ]},
    "layout": {"contentSize": "760px", "wideSize": "1180px"},
    "typography": {"fontFamilies": [
      {"slug": "body", "name": "Body Sans", "fontFamily": "system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"},
      {"slug": "editorial", "name": "Editorial Serif", "fontFamily": "Georgia,'Times New Roman',serif"}
    ]}
  },
  "styles": {"color": {"background": "#F5F3EB", "text": "#14261E"}, "typography": {"fontFamily": "var(--wp--preset--font-family--body)"}}
}
